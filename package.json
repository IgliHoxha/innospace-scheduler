{
  "name": "innospace-scheduler",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Meeting-booth scheduler for Innospace Tirana: anyone books a booth without an account (Google sign-in optional, for weekly repeats), gets an email confirmation with a cancel link, and an admin approves and manages reservations from a dashboard.",
  "scripts": {
    "dev": "next dev -p 4001",
    "build": "next build",
    "start": "next start -p 4001",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "knip": "knip --no-progress",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "next": "^15.5.28",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "4.1.2",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.20.4",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "eslint-config-prettier": "^9.1.2",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "postcss": "^8.5.19",
    "prettier": "^3.9.3",
    "tailwindcss": "^3.4.19",
    "typescript": "5.7.3",
    "vitest": "^4.1.11"
  }
}
