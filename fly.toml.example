# No [env] block on purpose: every runtime var is a Fly secret (see .env.example).

app = 'innospace-scheduler'
primary_region = 'fra'

[build]

[[mounts]]
  source = 'scheduler_data'
  destination = '/app/data'

[http_service]
  internal_port = 4001
  force_https = true
  # Resumes from a memory snapshot in under a second instead of a 4s cold boot.
  auto_stop_machines = 'suspend'
  auto_start_machines = true
  min_machines_running = 0

[[vm]]
  size = 'shared-cpu-1x'
  memory = '256mb'
  cpu_kind = 'shared'
  cpus = 1
  memory_mb = 256
