# Every var is required unless marked optional, and an optional one left blank is off.

# ---- Email (Resend) ----
# A Resend-verified sender (onboarding@resend.dev until the domain verifies).
EMAIL_FROM=onboarding@resend.dev
# Optional: where replies land, named for this app, e.g. "Innospace Scheduler <info@yourdomain.com>".
EMAIL_REPLY_TO=
# Public URL that email links and the email logo are built on.
APP_BASE_URL=https://scheduler.example.com

# ---- Admin login ----
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
# Long random string signing the session cookie and the emailed cancel links.
AUTH_SECRET=replace-with-a-long-random-string

# ---- Rate limits ----
# Failed logins per account before a lockout, which escalates but never bans.
LOGIN_MAX_ATTEMPTS=5
# Base account lockout in seconds, multiplied on each repeat.
LOGIN_BLOCK_SECONDS=60
# Failed logins per IP before an IP lockout, and bookings per IP before a pause.
LOGIN_IP_MAX_ATTEMPTS=20
# Base IP lockout and booking pause in seconds, multiplied on each repeat.
LOGIN_IP_BLOCK_SECONDS=60
# IP lockouts before that IP is banned until restart; bookings never ban.
LOGIN_MAX_LOCKOUTS=10

# ---- Google sign-in (optional, both or neither) ----
# Web OAuth client with redirect URI <APP_BASE_URL>/api/auth/google/callback; enables weekly repeats.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cloudflare Turnstile (optional, both or neither) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Trusted proxy proof (optional) ----
# Add the Cloudflare Transform Rule setting x-origin-proof to this value FIRST, or every visitor shares one rate-limit bucket.
TRUSTED_PROXY_SECRET=

# ---- Storage ----
DATA_FILE=./data/scheduler.db

# ---- Scheduling ----
# Minute grid for start and end times; must divide 60.
TIME_STEP_MINUTES=5
MIN_RESERVATION_MINUTES=15
# Days after today that can be booked, so 14 offers 15 dates.
RESERVATION_WINDOW_DAYS=14
# Longer bookings wait for admin approval, and from this length on a note is required.
AUTO_APPROVE_MAX_HOURS=2
TZ=Europe/Tirane

# ---- Booths ----
# Comma-separated "id:Name:capacity", capacity optional.
SCHEDULER_BOOTHS=booth-1:Booth 1:2,booth-2:Booth 2:4,booth-3:Booth 3:6

# ---- Business contact (shown in every email) ----
EMAIL_SIGNOFF_NAME=Your Name
BUSINESS_NAME=Innospace Tirana
BUSINESS_PHONE=+000 000 000
BUSINESS_EMAIL=hello@example.com
BUSINESS_WEBSITE_URL=https://example.com

# ---- Optional ----
# Blank skips every email.
RESEND_API_KEY=
# Comma-separated CORS origins; blank allows any.
ALLOWED_ORIGINS=

# ---- Slack (optional) ----
# Incoming webhook new bookings are posted to; a secret.
SLACK_WEBHOOK_URL=

# ---- Telegram (optional, token and chat both needed) ----
# From @BotFather; press Start on the bot so it can message you.
TELEGRAM_BOT_TOKEN=
# Chat alerted to bookings awaiting approval: message.chat.id from the bot's getUpdates.
TELEGRAM_CHAT_ID=
# Lets that chat reply yes, no or delete; register the webhook with the same value (README).
TELEGRAM_WEBHOOK_SECRET=